# secrets — never (API keys, model keys, database passwords)
.env
.env.*
!.env.example
*.pem
*.key
# `npm run seed` remembers the Demo project's one-time API key here so a re-run reuses it and dedupes.
.seed-state.json

# build output and dependencies (arrive with Gate 3)
node_modules/
dist/
coverage/
coverage*/
.vite/

# local scratch databases and bench output
bench-out/

# Playwright (web e2e) artefacts
test-results/
playwright-report/
.playwright/

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/settings.json

# TypeScript incremental build state
*.tsbuildinfo
