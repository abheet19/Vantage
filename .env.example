# Copy to .env (git-ignored) or let tools/db-setup.ps1 write one with generated passwords.
# Three roles, three connection strings. The API refuses to start if RW is not vantage_app or RO is not vantage_reader.
VANTAGE_DATABASE_URL_RW=postgres://vantage_app:CHANGE_ME@127.0.0.1:5432/vantage
VANTAGE_DATABASE_URL_RO=postgres://vantage_reader:CHANGE_ME@127.0.0.1:5432/vantage
# Optional. When present the API applies pending migrations at boot; `npm run migrate` needs it.
# VANTAGE_DATABASE_URL_OWNER=postgres://vantage_owner:CHANGE_ME@127.0.0.1:5432/vantage
# Loopback by design (LLD D4): the query routes are unauthenticated; only ingest requires an API key.
VANTAGE_BIND=127.0.0.1
VANTAGE_PORT=4100
# Optional shared READ token. Leave UNSET (or empty) to keep the query/ask/insights routes open — the
# loopback default (D4). Set it (≥ 16 chars) to require `Authorization: Bearer <this>` on every read route
# (funnel/retention/trend/paths/count, ask, asks, events/catalog) — needed when the API is reachable off
# loopback (e.g. hosted behind the Caddy edge). This is a SINGLE shared read token for the whole instance,
# NOT a per-project ingest key: ingest keeps its own per-project key (ApiKeyGuard) and the two are
# independent. /health stays open so orchestrator/health probes work; it exposes no analytics data.
# Generate one with e.g. `openssl rand -hex 32`. Keep it only in .env (git-ignored) or a secrets store.
# VANTAGE_QUERY_TOKEN=
# Optional shared ADMIN token. Leave UNSET (or empty) to keep the project-admin WRITE routes open — the
# loopback default (D4). Set it (≥ 16 chars) to require `Authorization: Bearer <this>` on `POST /v1/projects`
# (create project) and `POST /v1/projects/:id/rotate-key` (rotate ingest key) — needed when the API is
# reachable off loopback (e.g. a public read-only demo behind the Caddy edge) so visitors cannot create
# projects or rotate keys; missing/wrong → 401 INVALID_ADMIN_TOKEN. This is a SINGLE shared admin token for
# the whole instance, INDEPENDENT of VANTAGE_QUERY_TOKEN (reads) and of the per-project ingest key. The read
# routes (funnel/…/count, ask, asks, events/catalog) and `GET /v1/projects` (list) stay open regardless of it.
# Generate one with e.g. `openssl rand -hex 32`. Keep it only in .env (git-ignored) or a secrets store.
# VANTAGE_ADMIN_TOKEN=
# Integration tests: leave unset to use an embedded PostgreSQL 17; set to a SUPERUSER url of a cluster
# where the harness may create roles and drop/create a database named vantage_test.
# VANTAGE_TEST_DB=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Optional. The role the migration runner must be connected as (it refuses any other); only for clusters whose owner role is named differently.
# VANTAGE_MIGRATION_ROLE=vantage_owner
# Which model answers POST /v1/ask (LLD §1.1). `none` (default) maps the demo questions to specs with no model at all,
# so the boundary demo never depends on one; `ollama` talks to http://127.0.0.1:11434 (free, local); `anthropic` uses
# the official SDK and is only constructed when the key below is set. Whatever the adapter, the model only ever emits
# text that the grammar validates — the boundary is structural (design §4), not a wording in the prompt.
VANTAGE_LLM=none
# Ollama chat model; any model that honours `format` works. Pull it first: `ollama pull llama3.1`.
VANTAGE_OLLAMA_MODEL=llama3.1
# Context window asked of the Ollama model (options.num_ctx). Ollama's own default, 2048, is smaller than the grammar
# alone; 16384 holds the grammar, a budgeted catalog and the answer. Raise it only if the model supports it.
VANTAGE_OLLAMA_NUM_CTX=16384
# Anthropic: the key lives ONLY in .env (git-ignored); never commit it. Model defaults to the undated Haiku 4.5 alias,
# which follows the current snapshot; pin a dated id here if you need a fixed one.
# VANTAGE_ANTHROPIC_API_KEY=sk-ant-...
VANTAGE_ANTHROPIC_MODEL=claude-haiku-4-5
# MCP server (`node apps/api/dist/mcp.js`, registered by `npm run mcp:install`): `explain_query` returns a PostgreSQL
# plan only when this is 1 (LLD D3). A plan describes table statistics, so the default hides it; 0 or 1, nothing else.
VANTAGE_EXPOSE_PLANS=0
